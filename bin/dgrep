#!/bin/bash

if [ ! -f ~/.dgrep-servers ]; then
  echo "No file ~/.dgrep-servers"
  exit 1
fi

while read -r server; do
  # shellcheck disable=SC2029 # $@ is intentionally expanded locally to build the remote command.
  ssh "$server" grep "$@" 2>&1 | sed -e "s/^\(.*\)$/${server}: \1/"
done < ~/.dgrep-servers
