#!/bin/bash

if [ -f "$HOME/.noeclim" ]; then
  # If ~/.noeclim is present, don't bother.
  exit 0
fi

# If it's installed, start a zinc scalac server if we haven't already.
some_zinc=$(which zinc)
if [ -n "$some_zinc" ]; then
  { /usr/bin/env zinc -start >/dev/null; } 2>&1
fi

isrunning=$(pgrep -f /eclimd)
eclipse_running=$(pgrep -f /eclipse)
if [ -n "$CANCEL_ECLIMD" ]; then
  exit 0
fi
if [ -z "$isrunning" ] && [ -z "$eclipse_running" ]; then
  start-eclimd
fi

