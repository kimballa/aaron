#!/usr/bin/env bash
#
# Deploy my configuration files into the home dir.

set -e

bin=$(readlink -f "$0")
bin=$(dirname "${bin}")
bin=$(cd "${bin}" && pwd)

etcdir=$(cd "${bin}/../etc" && pwd)

makesafelink() {
  # Three arguments:
  # original (e.g., $HOME/.bashrc)
  # backup (e.g., $HOME/.localbashrc) - where existing original backs up to.
  # target (e.g., $etcdir/bashrc) - Where a symlink should target
  #
  # This creates a symlink from original -> target.
  # If original already exists, moves it to backup.
  # If backup already exists, gives up.
  # If original is already a symlink but is broken (dangling), it is
  # repaired to point at target instead of being left alone.
  original=$1
  backup=$2
  target=$3
  if [ ! -L "$original" ]; then
    # original is not already a symlink
    if [ ! -e "$original" ]; then
      # original doesn't exist. Make the link.
        echo "Setting $original as symlink -> $target"
        ln -s "$target" "$original"
    elif [ -f "$original" ]; then
      if [ ! -e "$backup" ]; then
        echo "Moving $original to $backup"
        mv "$original" "$backup"
        echo "Setting $original as symlink -> $target"
        ln -s "$target" "$original"
      else
        echo "Already have a $backup Giving up."
      fi
    else
      echo "$original not a file? Not changing it."
    fi
  elif [ ! -e "$original" ]; then
    # original is a symlink, but it's broken (dangling). Repair it.
    echo "$original is a broken symlink. Repairing it to point -> $target"
    rm "$original"
    ln -s "$target" "$original"
  else
    echo "$original is already a symlink. Not changing it."
  fi
}

# Install a regular configuration file, preserving a differing existing file.
# Arguments: destination path, backup path, and source file to copy.
# Existing symlinks are replaced without changing their targets. If a differing
# regular file and its backup both exist, leave them intact and return failure.
makesafecopy() {
  local original=$1 backup=$2 target=$3 temporary
  if [ -e "$original" ] && [ ! -L "$original" ] && ! cmp -s "$original" "$target"; then
    if [ ! -f "$original" ] || [ -e "$backup" ] || [ -L "$backup" ]; then
      echo "Cannot safely back up $original to $backup. Not changing it." >&2
      return 1
    fi
    mv "$original" "$backup"
  fi
  temporary=$(mktemp "${original}.XXXXXX")
  cp "$target" "$temporary"
  chmod 644 "$temporary"
  # Rename replaces the symlink itself; copying directly would follow it.
  mv -f "$temporary" "$original"
}

echo "Installing bash config..."
makesafelink "$HOME"/.bashrc "$HOME"/.localbashrc "${etcdir}"/bashrc
# Login shells read .bash_profile, not .bashrc; point it at .bashrc.
makesafelink "$HOME"/.bash_profile "$HOME"/.bash_profile.orig "$HOME"/.bashrc
makesafelink "$HOME"/.vind-exclude "$HOME"/.vind-exclude.orig "${etcdir}"/vind-exclude
makesafelink "$HOME"/.dircolors "$HOME"/.dircolors.orig "${etcdir}"/dircolors
makesafelink "$HOME"/.ctags "$HOME"/.ctags.orig "${etcdir}"/ctags

if [ "$(uname -s)" = Darwin ]; then
  echo ""
  echo "Installing macOS text editing keys..."
  makesafelink "$HOME"/.inputrc "$HOME"/.inputrc.orig "${etcdir}"/macos/inputrc
  mkdir -p "$HOME/Library/KeyBindings"
  # Sandboxed apps can read this folder but cannot follow links into the repo.
  makesafecopy "$HOME/Library/KeyBindings/DefaultKeyBinding.dict" \
    "$HOME/Library/KeyBindings/DefaultKeyBinding.dict.orig" \
    "${etcdir}/macos/DefaultKeyBinding.dict"
fi

echo ""
echo "Installing vim config..."
makesafelink "$HOME"/.vimrc "$HOME"/.vimrc.orig "${etcdir}"/vimrc
makesafelink "$HOME"/.vim "$HOME"/.vim.orig "${etcdir}"/vim

echo ""
echo "Installing other personal config files..."
makesafelink "$HOME"/.gitconfig "$HOME"/.gitconfig.orig "${etcdir}"/gitconfig

echo ""
echo "Installing Claude Code plugin..."
# A plugin dir under ~/.claude/skills/ auto-loads as <name>@skills-dir, so
# symlinking the whole plugin means new skills and agents deploy automatically.
claudedir=$(cd "${bin}/../claude" && pwd)
mkdir -p "$HOME/.claude/skills"
makesafelink "$HOME/.claude/skills/aaron" "$HOME/.claude/skills/aaron.orig" "${claudedir}/plugin"
makesafelink "$HOME/.claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md.orig" "${claudedir}/CLAUDE.md"

echo ""
echo "Installing Codex instructions..."
codexdir=$(cd "${bin}/../codex" && pwd)
mkdir -p "$HOME/.codex"
makesafelink "$HOME/.codex/AGENTS.md" "$HOME/.codex/AGENTS.md.orig" "${codexdir}/AGENTS.md"

if command -v codex >/dev/null 2>&1; then
  echo ""
  echo "Installing Codex plugin..."
  codex plugin marketplace add "${bin}/.."
  codex plugin add aaron@aaron-personal
else
  echo "Codex is not installed; skipping Codex plugin."
fi

# Make subdirectories in home for capabilities I use.
# These start empty, but are referenced in my bashrc.
echo ""
echo "Setting up home directories..."
set -x
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.local/share/bin"
mkdir -p "$HOME/.ssh"
{ set +x; } 2>/dev/null

makesafelink "$HOME/bin" "$HOME/bin.orig" "${bin}"
completion_dir="${etcdir}/../bash_completion.d"
completion_dir=$(readlink -f "${completion_dir}")
makesafelink "$HOME/.local/share/bash_completion.d" "$HOME/.local/share/bash_completion.d.orig" "${completion_dir}"

echo ""
echo "Done. Welcome home!"


