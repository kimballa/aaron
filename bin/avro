#!/usr/bin/env bash
#
# Run avro tools.

if [ -z "$AVRO_HOME" ]; then
  AVRO_HOME="$HOME/lib"
fi

if [ -z "$JAVA_HOME" ]; then
  echo "Warning: JAVA_HOME not set."
  JAVA_EXEC="java"
else
  JAVA_EXEC="$JAVA_HOME/bin/java"
fi

AVRO_JAR=$(find "$AVRO_HOME" -maxdepth 1 -name 'avro-tools-*' | sort | head -1)

exec "$JAVA_EXEC" -jar "$AVRO_JAR" "$@"
