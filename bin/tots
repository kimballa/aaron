#!/bin/bash

if [ -z "$1" ]; then
  set -- "$(date '+%Y-%m-%d %H:%M:%S')"
fi

python3 - "$@" <<'EOF'
from datetime import datetime
import sys
import time

if len(sys.argv) < 2:
  print("Must specify %Y-%m-%d %H:%M:%S")
  sys.exit(1)

print(int(time.mktime(
    datetime.strptime(" ".join(sys.argv[1:]), "%Y-%m-%d %H:%M:%S").timetuple()) * 1000))
EOF
