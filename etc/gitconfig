[user]
  name = Aaron Kimball
  email = akimball83@gmail.com
[color]
  ui = true
[core]
  editor = vim
  whitespace = trailing-space,space-before-tab
[diff]
  mnemonicprefix = true
[push]
  default = simple
	autoSetupRemote = true
[rerere]
  enabled = true
[fetch]
  prune = true
[init]
  defaultBranch = main
[advice]
	skippedCherryPicks = false

# Machine/work-specific overrides (email, corp includes, LFS, etc.) live in
# ~/.gitconfig.local, which is not tracked by this repo. This include is a
# silent no-op on machines where that file doesn't exist.
[include]
  path = ~/.gitconfig.local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
